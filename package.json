{
  "name": "senior-math-qa",
  "version": "1.0.0",
  "description": "Specification-driven validation framework for the Evolution Senior Math QA home task",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "coverage": "vitest run --coverage",
    "validate": "tsx src/cli.ts",
    "ci": "npm run verify",
    "validate:analysis": "tsx src/cli.ts",
    "validate:gate": "tsx src/cli.ts --gate",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run coverage && npm run validate"
  },
  "keywords": [],
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.6",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^5.0.1",
    "allure-vitest": "^3.12.2",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
